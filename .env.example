# Public browser configuration (publishable values only)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side data/auth configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Gateway (server secret; never prefix with VITE_)
LOVABLE_API_KEY=

# Paddle billing
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox

# Voice provider
ELEVENLABS_API_KEY=

# Rendering provider (use Shotstack or a compatible RENDERER_URL service)
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=stage
RENDERER_URL=
RENDERER_API_KEY=

# YouTube / Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=https://YOUR-DOMAIN/youtube/callback
# Base64-encoded 32 random bytes
YOUTUBE_TOKEN_ENCRYPTION_KEY=

# Observability (optional)
SENTRY_DSN=
APP_NAME=DCXORA
